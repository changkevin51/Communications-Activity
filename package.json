{
  "name": "signal-shift",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n server,client \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/server/index.js",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "sim": "tsx tests/sim/sim.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:bundle": "tsx tests/bundle/forbidden-words.ts"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "fastify": "5.12.5",
    "socket.io": "4.8.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@fontsource-variable/anybody": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "motion": "13.4.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "socket.io-client": "4.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
